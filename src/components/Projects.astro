---
import { Badge } from "@/components/ui/badge";
import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card";

const projects = [
  {
    title: "Turbo Stable",
    tagline: "A deployment dashboard for racing teams.",
    description:
      "Real-time stats, feed pipeline, and a live race-track view. Placeholder project description.",
    tags: ["Astro", "TypeScript", "Tailwind", "shadcn/ui"],
    accent: "from-racing-pink to-steeple-purple",
  },
  {
    title: "Finish Line CMS",
    tagline: "Headless content for event organizers.",
    description:
      "Author content, schedule races, and publish in seconds with a blazing-fast editor. Placeholder.",
    tags: ["React", "Node", "PostgreSQL"],
    accent: "from-grand-prix-sky to-turf-green",
  },
  {
    title: "Paddock Analytics",
    tagline: "Predictive insights for form & performance.",
    description:
      "Charts and forecasts that help coaches make smarter calls. Placeholder project description.",
    tags: ["Next.js", "D3", "OpenAI"],
    accent: "from-finish-gold to-racing-pink",
  },
];
---

<section id="projects" class="scroll-mt-20 py-20">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="flex flex-col items-start justify-between gap-4 sm:flex-row sm:items-end">
      <div class="max-w-2xl">
        <Badge variant="secondary">Projects</Badge>
        <h2 class="mt-4 font-heading text-3xl font-black tracking-tight sm:text-4xl">
          Selected projects
        </h2>
        <p class="mt-4 text-lg text-muted-foreground">
          Sample projects for this portfolio template. Replace these examples and add real case study URLs before publishing.
        </p>
      </div>
    </div>

    <div class="mt-10 grid gap-6 md:grid-cols-3">
      {projects.map((project) => (
        <Card class="flex flex-col overflow-hidden transition-shadow hover:shadow-lg">
          <div class={`h-2 w-full bg-gradient-to-r ${project.accent}`} aria-hidden="true"></div>
          <CardHeader>
            <CardTitle class="font-heading text-xl">{project.title}</CardTitle>
            <p class="text-sm font-medium text-racing-pink">{project.tagline}</p>
          </CardHeader>
          <CardContent class="flex-1">
            <p class="text-sm leading-relaxed text-muted-foreground">{project.description}</p>
            <div class="mt-4 flex flex-wrap gap-2">
              {project.tags.map((tag) => (
                <Badge key={tag} variant="secondary">
                  {tag}
                </Badge>
              ))}
            </div>
          </CardContent>
        </Card>
      ))}
    </div>
  </div>
</section>
