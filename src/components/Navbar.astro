---
import { Button } from "@/components/ui/button";

const navLinks = [
  { label: "Profile", href: "#about" },
  { label: "Projects", href: "#projects" },
  { label: "Skills", href: "#skills" },
  { label: "Career", href: "#experience" },
  { label: "Contact", href: "#contact" },
];
---

<header class="sticky top-0 z-50 border-b border-border/60 bg-background/80 backdrop-blur supports-[backdrop-filter]:bg-background/60">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6">
    <a href="#top" class="group flex items-center gap-2.5 font-heading font-extrabold tracking-tight">
      <span
        class="grid h-9 w-9 place-items-center rounded-full bg-gradient-to-br from-racing-pink to-steeple-purple text-sm text-racing-pink-foreground shadow-md transition-transform group-hover:-rotate-6"
        aria-hidden="true"
      >
        T
      </span>
      <span>
        <span class="block text-base leading-none">Touka Kiseki</span>
        <span class="block text-[11px] font-medium uppercase tracking-widest text-muted-foreground">
          Trainer &amp; Engineer
        </span>
      </span>
    </a>

    <nav class="hidden items-center gap-1 md:flex">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="rounded-md px-3 py-2 text-sm font-medium text-muted-foreground transition-colors hover:bg-accent hover:text-accent-foreground"
        >
          {link.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <Button asChild variant="ghost" class="md:hidden">
        <a href="#contact">Contact</a>
      </Button>
      <Button asChild class="hidden md:inline-flex">
        <a href="#contact">Get in touch</a>
      </Button>
    </div>
  </div>
</header>
