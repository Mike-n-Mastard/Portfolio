---
import { Badge } from "@/components/ui/badge";
import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card";

---

<section id="experience" class="scroll-mt-20 py-20">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="max-w-2xl">
      <Badge variant="secondary">Career</Badge>
      <h2 class="mt-4 font-heading text-3xl font-black tracking-tight sm:text-4xl">
        Race record
      </h2>
      <p class="mt-4 text-lg text-muted-foreground">
        Add your roles, organizations, dates, and accomplishments here.
      </p>
    </div>

    <Card class="mt-10">
      <CardHeader>
        <CardTitle class="font-heading text-lg">Experience details not added</CardTitle>
      </CardHeader>
      <CardContent>
        <p class="text-sm text-muted-foreground">Replace this note with your actual career history before publishing.</p>
      </CardContent>
    </Card>
  </div>
</section>
